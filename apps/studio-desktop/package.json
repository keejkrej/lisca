{
  "name": "@lisca/studio-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "bun --filter @lisca/studio-web build && bun --filter @lisca/studio-server build",
    "dev": "concurrently -k -n web,desk \"bun --filter @lisca/studio-web dev\" \"cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5175 wait-on -t 120000 tcp:127.0.0.1:5175 && electron .\"",
    "typecheck": "bunx oxlint electron/main.cjs electron/preload.cjs"
  },
  "devDependencies": {
    "@lisca/studio-server": "workspace:*",
    "@lisca/studio-web": "workspace:*",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.2.1",
    "wait-on": "^8.0.3"
  }
}

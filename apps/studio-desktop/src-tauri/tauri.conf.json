{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studio",
  "version": "0.1.0",
  "identifier": "com.lisca.studio.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @lisca/studio-web dev",
    "beforeBuildCommand": "pnpm --filter @lisca/studio-web build",
    "devUrl": "http://127.0.0.1:5175",
    "frontendDist": "../studio-web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Studio",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {}
}

.{
    .id = "com.lisca.annotator.desktop",
    .name = "lisca-annotator",
    .display_name = "Annotator",
    .version = "0.1.0",
    .icons = .{ "assets/icon.ico", "assets/icon.png", "assets/AppIcon.icns" },
    .platforms = .{ "macos", "linux" },
    .permissions = .{},
    .capabilities = .{ "webview" },
    .frontend = .{
        .dist = "frontend/dist",
        .entry = "index.html",
        .spa_fallback = true,
        .dev = .{
            .url = "http://127.0.0.1:5174/",
            .command = .{ "pnpm", "turbo", "run", "dev", "--filter", "@lisca/annotator-web", "--", "--host", "127.0.0.1" },
            .ready_path = "/",
            .timeout_ms = 30000,
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline", "http://127.0.0.1:5174" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
    .windows = .{
        .{ .label = "main", .title = "Annotator", .width = 1280, .height = 800, .restore_state = true },
    },
}

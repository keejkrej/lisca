{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Annotator",
  "version": "0.1.0",
  "identifier": "com.lisca.annotator.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @lisca/annotator-web dev",
    "beforeBuildCommand": "pnpm --filter @lisca/annotator-web build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../annotator-web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Annotator",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {}
}

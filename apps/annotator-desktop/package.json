{
  "name": "@lisca/annotator-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "pnpm --filter @lisca/annotator-web build && pnpm --filter @lisca/annotator-server build",
    "dev": "concurrently -k -n web,desk \"pnpm --filter @lisca/annotator-web dev\" \"cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 wait-on -t 120000 tcp:127.0.0.1:5174 && electron .\"",
    "lint": "node --check electron/main.cjs && node --check electron/preload.cjs"
  },
  "devDependencies": {
    "@lisca/annotator-server": "workspace:*",
    "@lisca/annotator-web": "workspace:*",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.2.1",
    "wait-on": "^8.0.3"
  }
}

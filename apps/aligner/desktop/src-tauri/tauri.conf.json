{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lisca Aligner",
  "version": "0.1.0",
  "identifier": "com.lisca.aligner",
  "build": {
    "beforeDevCommand": "vp run --filter @lisca/aligner-web dev",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:8765",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "deb"],
    "resources": {
      "resources/": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

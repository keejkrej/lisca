{
  "expo": {
    "name": "Lisca Aligner",
    "slug": "lisca-aligner-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "lisca-aligner",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lisca.aligner.mobile"
    },
    "android": {
      "package": "com.lisca.aligner.mobile",
      "usesCleartextTraffic": true
    },
    "plugins": ["expo-router"],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}

{
  "name": "@lisca/annotator-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "bun --filter @lisca/annotator-web build && bun --filter @lisca/annotator-server build",
    "dev": "concurrently -k -n web,desk \"bun --filter @lisca/annotator-web dev\" \"cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:8766 wait-on -t 120000 tcp:127.0.0.1:8766 && electron .\"",
    "dist": "bun ../../../scripts/package-desktop.mjs annotator",
    "typecheck": "bunx oxlint electron/main.cjs electron/preload.cjs"
  },
  "dependencies": {
    "wait-on": "^8.0.3"
  },
  "devDependencies": {
    "@lisca/annotator-server": "workspace:*",
    "@lisca/annotator-web": "workspace:*",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "catalog:",
    "electron-builder": "^25.1.8"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lisca Annotator",
  "version": "0.4.6",
  "identifier": "com.lisca.annotator",
  "build": {
    "beforeDevCommand": "pnpm run --filter @lisca/annotator-web dev",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:18766",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "deb"],
    "resources": {
      "resources/": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

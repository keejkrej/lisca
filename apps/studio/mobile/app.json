{
  "expo": {
    "name": "Lisca Studio",
    "slug": "lisca-studio-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "lisca-studio",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lisca.studio.mobile"
    },
    "android": {
      "package": "com.lisca.studio.mobile",
      "usesCleartextTraffic": true
    },
    "plugins": ["expo-router"]
  }
}

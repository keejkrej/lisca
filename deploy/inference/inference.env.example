# Copy to ~/.config/lisca/inference.env, chmod 600, and replace the token.
LISCA_INFERENCE_TOKEN=replace-with-a-random-token-at-least-24-characters
# Exact browser origins; no wildcard. Add the origin of your hosted Studio.
LISCA_INFERENCE_ORIGINS=http://localhost:18767,http://127.0.0.1:18767,tauri://localhost,http://tauri.localhost,https://tauri.localhost
# Optional initial reference import from the killing-assay offline experiment.
# LISCA_INFERENCE_REFERENCES=/home/jack/data/fig6-apoptosis-embedding-20261006

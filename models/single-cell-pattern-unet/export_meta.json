{
  "task": "binary_semantic_segmentation",
  "labels": {
    "0": "background",
    "1": "foreground"
  },
  "image_size": 128,
  "input_name": "pixel_values",
  "output_name": "logits",
  "output_layout": "NCHW",
  "output_channels": 1,
  "threshold": 0.5,
  "base_channels": 32,
  "preprocess": {
    "resize": 128,
    "grayscale_to_rgb": true,
    "normalize": {
      "mean": [0.485, 0.456, 0.406],
      "std": [0.229, 0.224, 0.225]
    }
  },
  "postprocess": {
    "activation": "sigmoid",
    "threshold": 0.5,
    "resize_to_original": true,
    "fill_holes": true
  }
}

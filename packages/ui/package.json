{
  "name": "@lisca/ui",
  "private": true,
  "files": [
    "src",
    "styles",
    "theme.css"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#components/*": "./src/components/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#ui/*": "./src/components/ui/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./icons": {
      "types": "./src/icons/index.ts",
      "import": "./src/icons/index.ts"
    },
    "./shell": {
      "types": "./src/shell/index.ts",
      "import": "./src/shell/index.ts"
    },
    "./patterns": {
      "types": "./src/patterns/index.ts",
      "import": "./src/patterns/index.ts"
    },
    "./primitives": {
      "types": "./src/components/ui/index.ts",
      "import": "./src/components/ui/index.ts"
    },
    "./cn": {
      "types": "./src/lib/utils.ts",
      "import": "./src/lib/utils.ts"
    },
    "./*": {
      "types": "./src/components/ui/*.ts",
      "import": "./src/components/ui/*.ts"
    },
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vp test run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@effect/ui": "catalog:",
    "@effect/ui-kit": "catalog:",
    "@fontsource-variable/outfit": "^5.3.0",
    "@lisca/design-tokens": "workspace:*",
    "@lisca/ui-headless": "workspace:*",
    "@lisca/utils": "workspace:*",
    "@phosphor-icons/core": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "catalog:",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

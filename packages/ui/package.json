{
  "name": "@lisca/ui",
  "version": "0.1.0",
  "private": true,
  "files": [
    "src",
    "styles",
    "theme.css"
  ],
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx"
    },
    "./shell": {
      "types": "./src/shell/index.ts",
      "import": "./src/shell/index.ts"
    },
    "./features": {
      "types": "./src/features/index.ts",
      "import": "./src/features/index.ts"
    },
    "./components": {
      "types": "./src/components/ui/index.ts",
      "import": "./src/components/ui/index.ts"
    },
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@kobalte/core": "catalog:",
    "@lisca/contracts": "workspace:*",
    "@lisca/ui-headless": "workspace:*",
    "@lisca/utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "phosphor-icons-solid": "catalog:",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "catalog:",
    "jsdom": "^26.1.0",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  }
}

{
  "name": "@lisca/ui",
  "version": "0.1.0",
  "private": true,
  "files": [
    "src",
    "styles",
    "theme.css"
  ],
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#ui/*": "./src/components/ui/*.tsx"
  },
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx"
    },
    "./shell": {
      "types": "./src/shell/index.ts",
      "import": "./src/shell/index.ts"
    },
    "./features": {
      "types": "./src/features/index.ts",
      "import": "./src/features/index.ts"
    },
    "./components": {
      "types": "./src/components/ui/index.ts",
      "import": "./src/components/ui/index.ts"
    },
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@corvu/calendar": "^0.1.2",
    "@corvu/drawer": "^0.2.4",
    "@corvu/otp-field": "^0.1.4",
    "@corvu/resizable": "^0.2.5",
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@kobalte/core": "catalog:",
    "@lisca/contracts": "workspace:*",
    "@lisca/ui-headless": "workspace:*",
    "@lisca/utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk-solid": "^1.1.2",
    "date-fns": "^4.4.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-solid": "^8.6.0",
    "lucide-solid": "^1.31.0",
    "phosphor-icons-solid": "catalog:",
    "solid-recharts": "1.0.1",
    "solid-sonner": "^0.3.1",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "catalog:",
    "jsdom": "^26.1.0",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  }
}

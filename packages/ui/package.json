{
  "name": "@lisca/ui",
  "private": true,
  "files": [
    "src",
    "styles",
    "theme.css"
  ],
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#ui/*": "./src/components/ui/*.tsx"
  },
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx"
    },
    "./shell": {
      "types": "./src/shell/index.ts",
      "import": "./src/shell/index.ts"
    },
    "./patterns": {
      "types": "./src/patterns/index.ts",
      "import": "./src/patterns/index.ts"
    },
    "./primitives": {
      "types": "./src/components/ui/index.ts",
      "import": "./src/components/ui/index.ts"
    },
    "./cn": {
      "types": "./src/lib/utils.ts",
      "import": "./src/lib/utils.ts"
    },
    "./*": {
      "types": "./src/components/ui/*.tsx",
      "import": "./src/components/ui/*.tsx"
    },
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vp test run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@lisca/design-tokens": "workspace:*",
    "@lisca/ui-headless": "workspace:*",
    "@lisca/utils": "workspace:*",
    "@ui-sdk/core": "0.1.0-beta.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "phosphor-icons-solid": "catalog:",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "catalog:",
    "jsdom": "^26.1.0",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  }
}

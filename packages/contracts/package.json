{
  "name": "@lisca/contracts",
  "version": "0.1.0",
  "private": true,
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "generate": "cargo run -p lisca --features export-typescript --bin export-typescript --manifest-path ../../crates/lisca/Cargo.toml",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}

{
  "name": "@lisca/contracts",
  "version": "0.1.0",
  "private": true,
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./http-api": {
      "types": "./src/http-api.ts",
      "import": "./src/http-api.ts"
    },
    "./assay": {
      "types": "./src/assay.ts",
      "import": "./src/assay.ts"
    },
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "openapi": "bun scripts/gen-openapi.ts",
    "contract-schema": "bun scripts/gen-rust-schema.ts",
    "rust-types": "bun scripts/gen-rust-schema.ts && cargo typify contract.schema.json --crate 'lisca@0.1.0' --unknown-crates allow -o ../../crates/lisca/src/protocol/generated.rs",
    "generate": "bun scripts/gen-openapi.ts && bun scripts/gen-rust-schema.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

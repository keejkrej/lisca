{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "browser": true
  },
  "settings": {
    "react": {
      "version": "19.1.0"
    }
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/target/**",
    "**/.turbo/**",
    "**/node_modules/**",
    "**/coverage/**"
  ]
}

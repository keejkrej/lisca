{
  "name": "lisca",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "build:webs": "turbo run build --filter=@lisca/*-web",
    "check": "pnpm lint && pnpm typecheck && pnpm check:rust",
    "check:rust": "cargo check --workspace",
    "contracts:generate": "pnpm --filter @lisca/contracts generate",
    "dev": "turbo run dev",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "format": "pnpm fmt",
    "format:check": "pnpm fmt:check",
    "lisca": "node ./scripts/lisca.mjs",
    "lint": "oxlint . --report-unused-disable-directives",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "turbo": "^2.5.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22",
    "pnpm": "^10.11.0"
  },
  "packageManager": "pnpm@10.11.0"
}

{
  "name": "lisca",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*/*",
      "packages/*"
    ],
    "catalog": {
      "effect": "^3.21.2",
      "@effect-atom/atom-react": "^0.5.0",
      "@effect/experimental": "^0.60.0",
      "@effect/platform": "^0.96.1",
      "@effect/platform-browser": "^0.60.0",
      "@types/node": "^22.15.21",
      "typescript": "^5.9.2",
      "vitest": "^3.2.4",
      "@tanstack/react-router": "^1.169.2",
      "@tanstack/router-plugin": "^1.167.35",
      "@types/react": "^19.2.6",
      "@types/react-dom": "^19.2.3",
      "@tailwindcss/vite": "^4.1.8",
      "@vitejs/plugin-react": "^4.5.0",
      "babel-plugin-react-compiler": "^1.0.0",
      "tailwindcss": "^4.1.8",
      "vite": "^6.3.5",
      "electron": "^42.1.0",
      "react": "^19.1.0",
      "react-dom": "^19.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun lisca build workspace all",
    "dev": "bun lisca dev workspace all",
    "check": "vp run lint && vp run typecheck && vp run check:contracts && vp run check:rust && vp run test:packages",
    "test:packages": "bun --filter @lisca/utils test && bun --filter @lisca/analysis test && bun --filter @lisca/ui-headless test && bun --filter @lisca/client test && bun --filter @lisca/smart test && vp run test:scripts",
    "test:scripts": "vp test run scripts/lisca-dev.test.ts --exclude '.deploy/**'",
    "check:contracts": "vp run contracts:generate && vp exec bun scripts/check-openapi-routes.ts && bun --filter @lisca/contracts test",
    "check:rust": "cargo check --workspace && cargo clippy --workspace -- -D warnings",
    "contracts:generate": "bun --filter @lisca/contracts generate",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "format": "vp run fmt",
    "format:check": "vp run fmt:check",
    "lisca": "vp exec bun ./scripts/lisca.mjs",
    "postinstall": "vp exec node ./scripts/install-electron.mjs && vp exec node ./scripts/install-skia.mjs",
    "lint": "vp lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.28.6",
    "@types/node": "catalog:",
    "@voidzero-dev/vite-plus-core": "latest",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-plugin-eslint": "1.68.0",
    "rcedit": "^4.0.1",
    "turbo": "^2.9.16",
    "typescript": "catalog:",
    "vite-plus": "latest",
    "vitest": "catalog:",
    "wait-on": "^8.0.3"
  },
  "overrides": {
    "effect": "catalog:",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "engines": {
    "bun": ">=1.2.14"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "core-js",
    "electron",
    "esbuild"
  ]
}

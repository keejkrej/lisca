{
  "name": "lisca",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*/*",
      "packages/*"
    ],
    "catalog": {
      "effect": "^3.21.2",
      "@effect-atom/atom-react": "^0.5.0",
      "@effect/experimental": "^0.60.0",
      "@effect/platform": "^0.96.1",
      "@effect/platform-browser": "^0.60.0",
      "@types/node": "^22.15.21",
      "typescript": "^5.9.2",
      "vitest": "^3.2.4",
      "@tanstack/react-router": "^1.169.2",
      "@tanstack/router-plugin": "^1.167.35",
      "@types/react": "^19.2.6",
      "@types/react-dom": "^19.2.3",
      "@tailwindcss/vite": "^4.1.8",
      "@vitejs/plugin-react": "^4.5.0",
      "tailwindcss": "^4.1.8",
      "vite": "^6.3.5",
      "electron": "^42.1.0",
      "react": "^19.1.0",
      "react-dom": "^19.1.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "build:site": "bun scripts/build-landing-site.mjs",
    "build:webs": "turbo run build --filter=@lisca/*-web --filter=@lisca/*-demo --filter=@lisca/landing-web",
    "dev:site": "turbo run dev --filter=@lisca/landing-web --filter=@lisca/aligner-demo --filter=@lisca/annotator-demo",
    "check": "bun run lint && bun run typecheck && bun run check:contracts && bun run check:rust",
    "check:contracts": "bun run contracts:generate && bun scripts/check-openapi-routes.ts && bun --filter @lisca/contracts test",
    "check:rust": "cargo check --workspace",
    "contracts:generate": "bun --filter @lisca/contracts generate",
    "dev": "turbo run dev",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "format": "bun run fmt",
    "format:check": "bun run fmt:check",
    "lisca": "bun ./scripts/lisca.mjs",
    "postinstall": "node ./scripts/install-electron.mjs",
    "lint": "oxlint . --report-unused-disable-directives",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "rcedit": "^4.0.1",
    "turbo": "^2.5.4",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wait-on": "^8.0.3"
  },
  "overrides": {
    "effect": "catalog:",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "engines": {
    "bun": ">=1.2.14"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "core-js",
    "electron",
    "esbuild"
  ]
}

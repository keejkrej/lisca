{
  "name": "lisca",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:aligner": "vp run --parallel --filter @lisca/aligner-server --filter @lisca/aligner-web dev",
    "dev:annotator": "vp run --parallel --filter @lisca/annotator-server --filter @lisca/annotator-web dev",
    "dev:studio": "vp run --parallel --filter @lisca/studio-server --filter @lisca/studio-web dev",
    "dev:landing": "vp run --filter @lisca/landing-web dev",
    "build": "vp run --filter ./packages/* build && vp run --filter @lisca/*-web build",
    "dist:aligner": "vp exec node --experimental-strip-types scripts/package-tauri.ts aligner",
    "dist:annotator": "vp exec node --experimental-strip-types scripts/package-tauri.ts annotator",
    "dist:studio": "vp exec node --experimental-strip-types scripts/package-tauri.ts studio",
    "deploy:landing": "vp exec node --experimental-strip-types scripts/deploy-landing.ts",
    "serve:aligner": "vp exec node --experimental-strip-types scripts/serve.ts aligner",
    "serve:annotator": "vp exec node --experimental-strip-types scripts/serve.ts annotator",
    "serve:studio": "vp exec node --experimental-strip-types scripts/serve.ts studio",
    "check": "vp lint && vp run -r --no-cache typecheck && vp run check:contracts && vp run check:rust && vp run -r --no-cache test",
    "check:contracts": "vp run --filter @lisca/contracts generate && vp exec node --experimental-strip-types scripts/check-openapi-routes.ts && vp run --filter @lisca/contracts test",
    "check:rust": "cargo check --workspace && cargo clippy --workspace -- -D warnings",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp run -r --no-cache test",
    "test:scripts": "vp test run scripts/lisca-dev.test.ts scripts/lint-boundaries.test.ts --exclude '.deploy/**'",
    "typecheck": "vp run -r --no-cache typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@voidzero-dev/vite-plus-core": "latest",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-plugin-eslint": "1.68.0",
    "rcedit": "^4.0.1",
    "typescript": "catalog:",
    "vite-plus": "latest",
    "vitest": "catalog:",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.15.1"
}

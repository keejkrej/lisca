{
  "name": "lisca",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:aligner": "pnpm run --parallel --filter @lisca/aligner-server --filter @lisca/aligner-web dev",
    "dev:aligner-desktop": "pnpm run --filter @lisca/aligner-desktop dev",
    "dev:annotator": "pnpm run --parallel --filter @lisca/annotator-server --filter @lisca/annotator-web dev",
    "dev:annotator-desktop": "pnpm run --filter @lisca/annotator-desktop dev",
    "dev:studio": "pnpm run --parallel --filter @lisca/studio-server --filter @lisca/studio-web dev",
    "dev:studio-desktop": "pnpm run --filter @lisca/studio-desktop dev",
    "dev:studio-demo": "pnpm run --filter @lisca/studio-demo dev",
    "dev:mock": "pnpm run --filter @lisca/instrument-mock dev",
    "fixture:workspace": "pnpm run --filter @lisca/fixtures fixture",
    "dev:landing": "pnpm run --filter @lisca/landing-web dev",
    "build": "pnpm run --filter ./packages/* build && pnpm run --filter @lisca/*-web build",
    "dist:aligner": "node --experimental-strip-types scripts/package-tauri.ts aligner",
    "dist:annotator": "node --experimental-strip-types scripts/package-tauri.ts annotator",
    "dist:studio": "node --experimental-strip-types scripts/package-tauri.ts studio",
    "deploy:landing": "node --experimental-strip-types scripts/deploy-landing.ts",
    "serve:aligner": "node --experimental-strip-types scripts/serve.ts aligner",
    "serve:annotator": "node --experimental-strip-types scripts/serve.ts annotator",
    "serve:studio": "node --experimental-strip-types scripts/serve.ts studio",
    "check": "pnpm run lint && pnpm run -r typecheck && pnpm run check:contracts && pnpm run check:rust && pnpm run -r test && pnpm run test:scripts",
    "check:contracts": "pnpm run --filter @lisca/contracts generate && node --experimental-strip-types scripts/check-openapi-routes.ts && pnpm run --filter @lisca/contracts test",
    "check:rust": "cargo check --workspace && cargo clippy --workspace -- -D warnings",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "pnpm run -r test",
    "test:scripts": "vp test run scripts/check-openapi-routes.test.ts scripts/check-release-version.test.ts scripts/updater-manifest.test.ts scripts/lisca-dev.test.ts scripts/lint-boundaries.test.ts scripts/node-run.test.ts --exclude '.deploy/**'",
    "typecheck": "pnpm run -r typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^11.5.0",
    "oxlint-plugin-eslint": "1.68.0",
    "rcedit": "^4.0.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.5.1"
}

server {
    listen ${PUBLIC_PORT};
    root /srv/web;
    index index.html;

    location /fs/ {
        proxy_pass http://127.0.0.1:${PORT};
        proxy_set_header Host $host;
    }

    location /align/ {
        proxy_pass http://127.0.0.1:${PORT};
        proxy_set_header Host $host;
    }

    location /annotate/ {
        proxy_pass http://127.0.0.1:${PORT};
        proxy_set_header Host $host;
    }

    location /studio/ {
        proxy_pass http://127.0.0.1:${PORT};
        proxy_set_header Host $host;
    }

    location /profile/ {
        proxy_pass http://127.0.0.1:${PORT};
        proxy_set_header Host $host;
    }

    location /memory/ {
        proxy_pass http://127.0.0.1:${PORT};
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["HOST", "PORT", "VITE_WS_PORT", "VITE_WS_URL", "VITE_DEV_SERVER_URL"],
  "globalPassThroughEnv": ["PATHEXT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", "../../target/release/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "preview": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dist": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["release/**"]
    }
  }
}

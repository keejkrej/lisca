{
  "$schema": "https://v2-9-18.turborepo.dev/schema.json",
  "globalEnv": [
    "HOST",
    "PORT",
    "VITE_HTTP_URL",
    "VITE_HTTP_HOST",
    "VITE_HTTP_PORT",
    "VITE_DEV_SERVER_URL",
    "EXPO_PUBLIC_LISCA_HTTP_URL",
    "EXPO_PUBLIC_LISCA_HTTP_HOST",
    "EXPO_PUBLIC_LISCA_HTTP_PORT"
  ],
  "globalPassThroughEnv": [
    "LISCA_BUILD_DEMO_SITE",
    "PATHEXT",
    "RUSTUP_HOME",
    "CARGO_HOME",
    "TAURI_SIGNING_PRIVATE_KEY",
    "TAURI_SIGNING_PRIVATE_KEY_PASSWORD",
    "TAURI_ARCH",
    "TAURI_TARGET",
    "APPLE_DEVELOPER_ID",
    "APPLE_ID",
    "APPLE_PASSWORD",
    "APPLE_TEAM_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", "../../../target/release/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "preview": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dist": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["release/**"]
    }
  }
}

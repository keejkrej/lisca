{
  "$schema": "https://v2-9-18.turborepo.dev/schema.json",
  "globalEnv": [
    "HOST",
    "PORT",
    "VITE_WS_PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "EXPO_PUBLIC_LISCA_HTTP_URL",
    "EXPO_PUBLIC_LISCA_WS_URL",
    "EXPO_PUBLIC_LISCA_WS_HOST",
    "EXPO_PUBLIC_LISCA_WS_PORT"
  ],
  "globalPassThroughEnv": ["LISCA_BUILD_DEMO_SITE", "PATHEXT", "RUSTUP_HOME", "CARGO_HOME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", "../../../target/release/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "preview": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dist": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["release/**"]
    }
  }
}
